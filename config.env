# Shared settings for every step
WAF_PORT=8088                      # port SafeLine will listen on for the DVWA site
DVWA_PORT=8081                     # DVWA bound to 127.0.0.1 only (reachable only via the host)
WAF_URL=http://127.0.0.1:${WAF_PORT}
DIRECT_URL=http://127.0.0.1:${DVWA_PORT}
SAFELINE_DIR=/data/safeline        # default install dir of SafeLine
